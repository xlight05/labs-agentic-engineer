# AEP — environment variables (canonical, documented).
#
# Copy to `.env` and fill in. Every service reads env in exactly one place
# (its config module); add every new variable here when you introduce it.
#
# This file grows as services are ported in (plan.md §10). The scaffold itself
# needs no env vars.

# --- @aep/agents (TS spec agents, Vercel AI SDK) ---
# Anthropic API key for the spec agents (the main file-mutation agent reads it).
ANTHROPIC_API_KEY=
# SSE server listen port (src/main.ts; default 4000).
PORT=
# Log level; set to `debug` for per-turn token/finishReason logging.
LOG_LEVEL=
# Agent loop tuning.
AGENT_MODEL=
AGENT_MAX_STEPS=
# Max request body for the SSE turn endpoint (the inlined files snapshot).
AGENT_BODY_LIMIT=
# Eval suite (services/agents/evals). All optional.
# EVAL_SAMPLES: K runs per fixture for the model suite (default 3).
EVAL_SAMPLES=
# EVAL_RECORD=1: record a fixture's turns and print the resulting messages
# (for authoring captured-trace continuation fixtures); does not score.
EVAL_RECORD=
# EVAL_WRITE_PREVIEW=1: dump each turn's reconstructed snapshot under
# evals/.eval-preview/ for human inspection (gitignored).
EVAL_WRITE_PREVIEW=
