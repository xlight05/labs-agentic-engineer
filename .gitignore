# Dependencies
node_modules/

# Build output
dist/
build/
# …but never Go source packages named "build" (the unanchored pattern above
# would silently swallow them from every commit). The build package moved from
# a feature to the delivery domain's buildpipe sub-package in P6.
!services/aep-api/internal/delivery/build/
*.tsbuildinfo

# Turborepo
.turbo/

# Generated code (source of truth is the contract; regenerated by `make gen`)
generated/
*.gen.go
# …except the OpenChoreo API client: generated once from a pinned upstream
# spec via `make -C services/aep-api gen-oc-client` (network fetch, not part
# of `make gen`), so it must be checked in for builds to be reproducible.
!services/aep-api/internal/clients/openchoreo/gen/*.gen.go

# Env / secrets
.env
.env.*
!.env.example

# Dev playground threads (services/agents/playground)
chat_playground/

# Editor / OS
.DS_Store
*.log
.playwright-cli
.playwright-mcp
**/.agents/settings.local.json
**/.claude/settings.local.json
e2e_test_run.txt
new_spec.yml

# Personal learning notes (not part of the project)
learning/

# Git worktrees for isolated agent/dev work
.worktrees/

# Vitest browser-mode run artifacts (failure screenshots + attachments)
**/__screenshots__/
**/.vitest-attachments/
.scratch/
.agents/worktrees/

# Scheduled-task runtime lock (machine-local: pid + sessionId)
.agents/scheduled_tasks.lock
